// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  address     String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Relations
  branches    Branch[]
  users       User[]
  licenses    License[]
  settings    SchoolSettings[]
  auditLogs   AuditLog[]
  notifications Notification[]
  classrooms  Classroom[]
  questions   Question[]

  @@map("schools")
}

model Branch {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  code        String
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Relations
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users       User[]
  licenses    License[]
  settings    BranchSettings[]
  auditLogs   AuditLog[]
  notifications Notification[]
  classrooms  Classroom[]
  questions   Question[]

  @@unique([schoolId, code])
  @@map("branches")
}

model User {
  id          String   @id @default(uuid())
  schoolId    String
  branchId    String?
  email       String   @unique
  username    String   @unique
  password    String
  firstName   String
  lastName    String
  phone       String?
  role        UserRole
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Relations
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licenses    License[]
  auditLogs   AuditLog[]
  notifications Notification[]
  classrooms  Classroom[]
  enrollments ClassroomEnrollment[]
  discussions ClassroomDiscussion[]
  replies     DiscussionReply[]
  attendances ClassroomAttendance[]
  exams       Exam[]
  assignments Assignment[]
  submissions AssignmentSubmission[]
  questions   Question[]
  answers     Answer[]
  attempts    ExamAttempt[]

  @@map("users")
}

model License {
  id              String        @id @default(uuid())
  schoolId        String
  branchId        String?
  userId          String?
  licenseKey      String        @unique
  deviceId        String?
  deviceName      String?
  licenseType     LicenseType   @default(EDUCATIONAL)
  status          LicenseStatus @default(ACTIVE)
  expiresAt       DateTime?
  maxDevices      Int           @default(1)
  usedDevices     Int           @default(0)
  features        String[]      @default([]) // JSON array of enabled features
  isOfflineMode   Boolean       @default(false)
  lastSyncAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?

  // Relations
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  auditLogs       AuditLog[]

  @@map("licenses")
}

model SchoolSettings {
  id          String   @id @default(uuid())
  schoolId    String
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Relations
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@map("school_settings")
}

model BranchSettings {
  id          String   @id @default(uuid())
  branchId    String
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Relations
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@map("branch_settings")
}

model AuditLog {
  id          String      @id @default(uuid())
  schoolId    String
  branchId    String?
  userId      String?
  action      String
  resource    String
  resourceId  String?
  details     String?     // JSON string with additional details
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  // Relations
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  license     License?    @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  licenseId   String?

  @@map("audit_logs")
}

model Notification {
  id          String           @id @default(uuid())
  schoolId    String
  branchId    String?
  userId      String?
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  isGlobal    Boolean          @default(false)
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  createdBy   String?

  // Relations
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// Enums
enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  BURSAR
  STORE_MANAGER
}

enum LicenseType {
  EDUCATIONAL
  COMMERCIAL
  TRIAL
  DEMO
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  PENDING
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  LICENSE_EXPIRY
  LICENSE_REVOKED
}

model Classroom {
  id          String   @id @default(uuid())
  schoolId    String
  branchId    String?
  teacherId   String
  name        String
  code        String   @unique
  description String?
  subject     String
  grade       String?
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(false)
  maxStudents Int      @default(50)
  currentStudents Int  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments ClassroomEnrollment[]
  materials   ClassroomMaterial[]
  discussions ClassroomDiscussion[]
  attendances ClassroomAttendance[]
  exams       Exam[]
  assignments Assignment[]

  @@map("classrooms")
}

model ClassroomEnrollment {
  id          String   @id @default(uuid())
  classroomId String
  studentId   String
  enrolledBy  String?  // User ID who enrolled the student
  enrolledAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  // Relations
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@map("classroom_enrollments")
}

model ClassroomMaterial {
  id          String   @id @default(uuid())
  classroomId String
  title       String
  description String?
  type        MaterialType
  url         String?
  filePath    String?
  fileSize    Int?
  mimeType    String?
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  // Relations
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@map("classroom_materials")
}

model ClassroomDiscussion {
  id          String   @id @default(uuid())
  classroomId String
  userId      String
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     DiscussionReply[]

  @@map("classroom_discussions")
}

model DiscussionReply {
  id           String   @id @default(uuid())
  discussionId String
  userId       String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  discussion   ClassroomDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discussion_replies")
}

model ClassroomAttendance {
  id          String   @id @default(uuid())
  classroomId String
  studentId   String
  date        DateTime @db.Date
  status      AttendanceStatus @default(PRESENT)
  checkInTime DateTime?
  checkOutTime DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId, date])
  @@map("classroom_attendances")
}

model Exam {
  id          String   @id @default(uuid())
  classroomId String
  teacherId   String
  title       String
  description String?
  type        ExamType @default(ASSIGNMENT)
  duration    Int      // in minutes
  totalMarks  Int
  passingMarks Int
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)
  allowRetake Boolean  @default(false)
  maxAttempts Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher     User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tokens      ExamToken[]
  questions   Question[]
  attempts    ExamAttempt[]

  @@map("exams")
}

model ExamToken {
  id          String   @id @default(uuid())
  examId      String
  token       String   @unique
  studentId   String?
  isUsed      Boolean  @default(false)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  createdBy   String

  // Relations
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User?    @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@map("exam_tokens")
}

model Question {
  id          String   @id @default(uuid())
  examId      String
  schoolId    String
  branchId    String?
  classroomId String
  subject     String
  term        String
  teacherId   String
  question    String
  type        QuestionType
  options     String[] // JSON array for multiple choice
  correctAnswer String?
  explanation String?
  marks       Int      @default(1)
  difficulty  DifficultyLevel @default(MEDIUM)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  // Relations
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@map("questions")
}

model Answer {
  id          String   @id @default(uuid())
  questionId  String
  studentId   String
  answer      String
  isCorrect   Boolean?
  marksObtained Int?
  timeSpent   Int?     // in seconds
  createdAt   DateTime @default(now())

  // Relations
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([questionId, studentId])
  @@map("answers")
}

model ExamAttempt {
  id          String   @id @default(uuid())
  examId      String
  studentId   String
  token       String
  startTime   DateTime
  endTime     DateTime?
  submittedAt DateTime?
  totalMarks  Int      @default(0)
  marksObtained Int    @default(0)
  percentage  Float    @default(0)
  status      AttemptStatus @default(IN_PROGRESS)
  isOffline   Boolean  @default(false)
  syncedAt    DateTime?
  deviceInfo  String?  // JSON string with device details
  cheatAttempts Int    @default(0)
  tabSwitches Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("exam_attempts")
}

model Assignment {
  id          String   @id @default(uuid())
  classroomId String
  teacherId   String
  title       String
  description String
  instructions String?
  dueDate     DateTime
  totalMarks  Int
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher     User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  content      String
  filePath     String?
  marksObtained Int?
  feedback     String?
  submittedAt  DateTime @default(now())
  gradedAt     DateTime?
  status       SubmissionStatus @default(SUBMITTED)

  // Relations
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

// Enums
enum MaterialType {
  PDF
  AUDIO
  VIDEO
  DOCUMENT
  IMAGE
  LINK
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  ASSIGNMENT
  QUIZ
  MIDTERM
  FINAL
  PRACTICE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  ESSAY
  MATCHING
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  DISQUALIFIED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}